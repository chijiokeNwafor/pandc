# Server-only settings. Add these in Vercel Project Settings > Environment Variables.
ADMIN_EMAIL=you@example.com
# Generate with npm run admin:password (never store the plaintext password).
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
SITE_ORIGIN=http://localhost:3000
# Added automatically when you connect Neon through Vercel Storage.
# For local development, copy the Neon connection string into .env.local.
DATABASE_URL=
